{
  "name": "@azhan-crm/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude **/*.integration.test.ts --pool=threads --maxWorkers=1",
    "test:integration": "vitest run src/store.integration.test.ts --pool=threads --maxWorkers=1",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test:cleanup": "tsx src/drop-test-database.ts"
  },
  "dependencies": {
    "@azhan-crm/contracts": "*",
    "mysql2": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
